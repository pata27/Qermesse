; SilverSprint v3 — configuration du projet Godot.
;
; Regle d'or de docs/03 §2 : core/ ne connait ni la scene, ni le port serie, ni
; le rendu. Il tourne et se teste en headless.

config_version=5

[application]

config/name="SilverSprint v3"
config/description="Logiciel de course de rouleaux (goldsprints)."
; PRE-VERSION, et le numero le dit. Le critere de sortie de docs/05 est J6 — un
; tiers qui installe sur machine vierge et fait courir deux personnes sans aide
; — et il n'est pas franchi, pas plus que J1, la validation sur l'Arduino reel.
; Tout le reste l'est. Un 1.0 se pose apres une vraie soiree, pas avant.
config/version="0.9.0-beta"
config/features=PackedStringArray("4.5", "Forward Plus")
run/main_scene="res://scenes/main.tscn"

[display]

; FENETRES FILLES NATIVES, et non embarquees.
;
; Par defaut Godot dessine une fenetre fille A L'INTERIEUR de la fenetre
; principale, comme un panneau flottant. La fenetre spectacle etait donc
; prisonniere de la fenetre operateur : impossible de l'envoyer sur le second
; ecran ni de la passer en plein ecran sur le videoprojecteur, ce qui est
; exactement sa raison d'etre (docs/03 §6).
window/subwindows/embed_subwindows=false

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[rendering]

renderer/rendering_method="forward_plus"
