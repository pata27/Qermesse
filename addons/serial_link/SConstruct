#!/usr/bin/env python
"""Construction du GDExtension `serial_link`.

Chaine godot-cpp standard : SCons, godot-cpp en sous-module epingle sur
`godot-4.5-stable`, range dans `third_party/` — HORS de l'arborescence de
ressources : place sous `addons/`, son projet d'exemple (`test/project/`)
etait importe par Godot, icone comprise, et ses scripts scannes a chaque
lancement. C'est la seule partie du projet qui n'utilise pas CMake ;
tout le C++ testable (parseur, file SPSC, machine a etats du lien) se construit
et se teste par CMake, sans Godot.

    scons target=template_debug
    scons target=template_release
"""

import os

env = SConscript("../../third_party/godot-cpp/SConstruct")

# `ar` REÇOIT DES MILLIERS DE CHEMINS ABSOLUS, et le shell a une limite.
#
# godot-cpp compile plus de trois mille fichiers, puis les archive en une seule
# commande dont chaque argument porte le chemin complet du dépôt. Passé une
# centaine de caractères de préfixe, la ligne dépasse `ARG_MAX` et l'archivage
# échoue sur `sh: Argument list too long` — sans jamais nommer la cause.
#
# Le README traitait cela comme une fatalité et demandait de cloner dans un
# chemin court. Ce n'en est pas une : SCons sait écrire les arguments dans un
# fichier et appeler `ar @fichier`, ce que GNU ar comprend. La contrainte
# disparaît, et avec elle un piège qui frappe d'abord ceux qui clonent le
# projet là où leur système les met — c'est exactement ce qui est arrivé à la
# CI, dont le chemin de travail est imposé.
#
# `MAXLINELENGTH` est le seuil au-delà duquel SCons bascule sur le fichier ;
# en deçà, la commande part normalement. Posé sur le même objet `env` que
# celui de godot-cpp, donc son archive en bénéficie aussi — c'est elle qui
# échouait.
if env["platform"] == "linux":
    env["MAXLINELENGTH"] = 8192
    env["ARCOM"] = '${TEMPFILE("%s","$ARCOMSTR")}' % env["ARCOM"]

env.Append(CPPPATH=["src/"])

sources = [
    "src/line_parser.cpp",
    "src/port_selection.cpp",
    "src/link_driver.cpp",
    "src/serial_port_posix.cpp",
    "src/serial_port_win.cpp",
    "src/serial_link.cpp",
    "src/register_types.cpp",
]

# Enumeration des ports avec VID/PID : la seule dependance systeme du module.
if env["platform"] == "macos":
    env.Append(LINKFLAGS=["-framework", "IOKit", "-framework", "CoreFoundation"])
elif env["platform"] == "windows":
    # advapi32 porte RegQueryValueEx/RegCloseKey, utilises pour lire le nom du
    # port dans le registre. CMake le lie par defaut, SCons non.
    env.Append(LIBS=["setupapi", "advapi32"])

if env["platform"] == "macos":
    library = env.SharedLibrary(
        "bin/libserial_link.{}.{}.framework/libserial_link.{}.{}".format(
            env["platform"], env["target"], env["platform"], env["target"]
        ),
        source=sources,
    )
else:
    library = env.SharedLibrary(
        "bin/libserial_link{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
        source=sources,
    )

Default(library)
